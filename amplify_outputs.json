{
  "auth": {
    "aws_region": "us-east-1",
    "user_pool_id": "us-east-1_example",
    "web_client_id": "examplewebclient",
    "native_client_id": "exampleNativeClient",
    "oauth": {
      "domain": "https://afcs-uni-erp.auth.us-east-1.amazoncognito.com",
      "scope": [
        "email",
        "openid",
        "profile",
